rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'mbc122020@gmail.com';
    }

    // Client profile documents are keyed by Firebase Auth UID.
    // Clients may create/read only their own record; only admin manages case data.
    match /clients/{clientId} {
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == clientId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasAll([
          'name', 'email', 'phone', 'nationalId',
          'caseType', 'caseNumber', 'status'
        ])
      );
      allow read: if isAdmin() || (signedIn() && request.auth.uid == clientId);
      allow update, delete: if isAdmin();
    }

    // Case data is visible only to the admin and the linked client account.
    match /sessions/{sessionId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.clientId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    match /fees/{feeId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.clientId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    // Document metadata and Base64 content are never public.
    match /documents/{documentId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.clientId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'clientId', 'clientName', 'caseNumber', 'name',
          'type', 'size', 'base64', 'uploadedAt'
        ])
        && request.resource.data.keys().hasAll([
          'clientId', 'name', 'type', 'base64', 'uploadedAt'
        ]);
      allow update, delete: if isAdmin();
    }

    // Explicitly deny anything not listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
