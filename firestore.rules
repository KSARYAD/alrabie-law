rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'mbc122020@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isActiveClient(clientId) {
      return signedIn()
        && request.auth.uid == clientId
        && exists(/databases/$(database)/documents/clients/$(request.auth.uid))
        && get(/databases/$(database)/documents/clients/$(request.auth.uid)).data.accountStatus == 'active';
    }

    // Client profile documents are keyed by Firebase Authentication UID.
    match /clients/{clientId} {
      allow create: if isAdmin() || (
        signedIn()
        && request.auth.uid == clientId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.accountStatus == 'pending'
        && request.resource.data.caseNumber == 'بانتظار التخصيص'
        && request.resource.data.status == 'غير مسندة'
        && request.resource.data.keys().hasOnly([
          'authUid', 'name', 'email', 'phone', 'nationalId', 'caseType',
          'caseNumber', 'status', 'accountStatus', 'court', 'circuit',
          'filedDate', 'opponent', 'notes', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'authUid', 'name', 'email', 'phone', 'nationalId', 'caseType',
          'caseNumber', 'status', 'accountStatus', 'createdAt'
        ])
      );
      allow read: if isAdmin() || (signedIn() && request.auth.uid == clientId);
      allow update, delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() || isActiveClient(resource.data.clientId);
      allow create, update, delete: if isAdmin();
    }

    match /fees/{feeId} {
      allow read: if isAdmin() || isActiveClient(resource.data.clientId);
      allow create, update, delete: if isAdmin();
    }

    // Current portal stores uploaded file data in Firestore; keep it private.
    match /documents/{documentId} {
      allow read: if isAdmin() || isActiveClient(resource.data.clientId);
      allow create: if isActiveClient(request.resource.data.clientId)
        && request.resource.data.keys().hasOnly([
          'clientId', 'clientName', 'caseNumber', 'name',
          'type', 'size', 'base64', 'uploadedAt'
        ])
        && request.resource.data.keys().hasAll([
          'clientId', 'name', 'type', 'base64', 'uploadedAt'
        ])
        && request.resource.data.base64 is string
        && request.resource.data.base64.size() <= 900000;
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}