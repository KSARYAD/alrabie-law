rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'mbc122020@gmail.com';
    }

    // The current portal stores files in Firestore, not Cloud Storage.
    // Keep the bucket closed until file upload is migrated to authenticated storage.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}